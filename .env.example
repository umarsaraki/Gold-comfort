# --- PostgreSQL database connection ---
# Required for the PostgreSQL version (db-postgres.js / server-postgres.js).
# If using Render's free PostgreSQL, Render gives you these values directly
# on the database's dashboard page (usually as one combined "Internal
# Database URL" too — if you use that instead, db-postgres.js would need a
# small adjustment to accept a single connection string; ask before doing
# this if Render only gives you the combined URL).
PG_HOST=localhost
PG_PORT=5432
PG_USER=goldcomfort
PG_PASSWORD=replace-with-a-real-strong-password
PG_DATABASE=goldcomfort
